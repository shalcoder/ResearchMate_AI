# ==============================================================================
# ResearchMate AI - Environment Configuration Example
# ==============================================================================

# Application Environment (development / production / staging)
ENVIRONMENT=production
DEBUG=False

# Security & JWT Authentication
# Replace with a cryptographically strong 256-bit random key
SECRET_KEY=super_secret_jwt_production_key_for_researchmate_ai_2026_auth
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=researchmate_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_password@postgres:5432/researchmate_db

# ChromaDB Vector Store
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=/chroma/chroma

# Google Gemini API (For RAG grounded synthesis & summaries)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
