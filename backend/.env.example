# =================================================================
# ResearchMate AI - Backend Environment Configuration (.env.example)
# =================================================================

# Application Settings
PROJECT_NAME="ResearchMate AI"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security & JWT Authentication
# Generate a strong key in production using `openssl rand -hex 32`
SECRET_KEY="change_this_to_a_secure_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Settings (JSON list format)
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'

# Database Configuration (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="researchmate_db"
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/researchmate_db"

# Vector Database Configuration (ChromaDB)
CHROMA_HOST="localhost"
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY="./chroma_data"
CHROMA_COLLECTION_NAME="research_papers"

# Gemini API Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-1.5-pro"

# Cloudinary PDF File Storage
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Optional PDF Processing Settings
MAX_UPLOAD_SIZE_MB=25
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200
