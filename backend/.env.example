# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///./researchmate.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/researchmate_db

# Security
SECRET_KEY=your-secret-key-at-least-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Environment
ENVIRONMENT=development
