# ==================================================================
# ResearchMate AI - Frontend Environment Configuration (.env.example)
# ==================================================================

# Backend API Endpoint
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"

# Application Metadata
NEXT_PUBLIC_APP_NAME="ResearchMate AI"
NEXT_PUBLIC_APP_DESCRIPTION="Persistent AI-Enabled Academic Research Workspace"

# Feature Flags
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH="false"
NEXT_PUBLIC_MAX_FILE_SIZE_MB="25"
